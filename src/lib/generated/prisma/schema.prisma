generator client {
  provider   = "prisma-client-js"
  output     = "../src/lib/generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Session {
  id         String   @id @default(cuid())
  adminId    String?
  adminToken String?
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String?
  contentHtml   String?
  featuredImage String?
  status        String    @default("draft")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  readingTime   Int?
  categoryId    String?
  authorId      String?
  tags          BlogTag[]
  author        Admin?    @relation(fields: [authorId], references: [id])
  category      Category? @relation(fields: [categoryId], references: [id])
  seo           PostSeo?
}

model PostSeo {
  id                 String  @id @default(cuid())
  postId             String  @unique
  metaTitle          String?
  metaDesc           String?
  ogImage            String?
  canonical          String?
  noindex            Boolean @default(false)
  h1                 String?
  keywords           String?
  ogDescription      String?
  ogTitle            String?
  ogType             String?
  twitterDescription String?
  twitterTitle       String?
  schemaJsonLd       Json?
  post               Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  posts     Post[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  posts     BlogTag[]
}

model BlogTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Appointment {
  id            String    @id @default(cuid())
  name          String
  email         String
  phone         String?
  service       String?
  message       String?
  preferredDate DateTime?
  preferredTime String?
  status        String    @default("pending")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String?
  sourcePath String?
  status     String   @default("new")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int?
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  shortName    String
  summary      String
  cardImageSrc String
  cardImageAlt String
  cardBenefits Json
  order        Int      @default(0)
  status       String   @default("published")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  href         String

  @@index([status, order])
}

model Treatment {
  id        String    @id @default(cuid())
  slug      String    @unique
  href      String    @unique
  pillar    String
  audience  String?
  kind      String
  status    String    @default("published")
  order     Int       @default(0)
  data      Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model NewsItem {
  id             String   @id @default(cuid())
  title          String
  thumbnailUrl   String
  newsLink       String
  order          Int      @default(0)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  description    String?
  publishedLabel String?
  source         String?
  type           String   @default("article")

  @@index([published, order])
}

model Person {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  credentials String?
  role        String
  portraitSrc String
  portraitAlt String
  summary     String
  bio         Json
  specialties Json?
  featured    Boolean  @default(false)
  status      String   @default("published")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, order])
}

model PageSeo {
  id                           String   @id @default(cuid())
  path                         String   @unique
  canonical                    String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  keywords                     String?
  googleAnalyticsMeasurementId String?
  googleAnalyticsPresent       Boolean  @default(false)
  googleTagManagerId           String?
  googleTagManagerPresent      Boolean  @default(false)
  h1Hero                       String?
  hotjarPresent                Boolean  @default(false)
  hotjarSiteId                 String?
  jsonLd                       Json?
  metaDescription              String?
  metaPixelId                  String?
  metaPixelPresent             Boolean  @default(false)
  metaTitle                    String?
  metricoolPresent             Boolean  @default(false)
  openGraph                    Json?
  pageTitle                    String?
  plausiblePresent             Boolean  @default(false)
  robotsMeta                   String?
  sitemapChangefreq            String?
  sitemapInclude               Boolean  @default(true)
  sitemapPriority              Float?
  sourceFile                   String?
  twitter                      Json?
  url                          String?
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  roleLabel String?
  treatment String?
  quote     String
  rating    Int      @default(5)
  photoUrl  String?
  featured  Boolean  @default(false)
  status    String   @default("published")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source    String   @default("site")
}

model SiteSettings {
  id                    String   @id @default("singleton")
  siteName              String?
  tagline               String?
  logoUrl               String?
  logoDarkUrl           String?
  faviconUrl            String?
  phone                 String?
  email                 String?
  socialLinks           Json?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  defaultOgImageUrl     String?
  headerScripts         String?
  footerScripts         String?
  updatedAt             DateTime @updatedAt
  googleAnalyticsId     String?
  metaPixelId           String?
}
