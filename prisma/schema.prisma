generator client {
  provider = "prisma-client-js"
  engineType = "binary"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String    // bcrypt hash
  role      String    @default("admin")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     Post[]
}

model Session {
  id        String   @id @default(cuid())
  adminId   String?
  adminToken String? // for session-less token tracking
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String?   // TipTap JSON output
  contentHtml   String?   // Pre-rendered HTML for public display
  featuredImage String?
  status        String    @default("draft") // draft | published | archived
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  readingTime   Int?      // minutes

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  authorId   String?
  author     Admin?    @relation(fields: [authorId], references: [id])
  tags       BlogTag[]
  seo        PostSeo?
}

model PostSeo {
  id        String  @id @default(cuid())
  postId    String  @unique
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  metaTitle String?
  metaDesc  String?
  ogImage   String?
  canonical String?
  noindex   Boolean @default(false)
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  posts     Post[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  posts     BlogTag[]
}

model BlogTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Appointment {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  service       String?
  message       String?
  preferredDate DateTime?
  preferredTime String?
  status        String   @default("pending") // pending | confirmed | completed | cancelled
  notes         String?  // admin notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Lightweight lead capture — deliberately separate from `Appointment`
// (which represents an actual scheduling intent with preferred date/time).
// A `Lead` is a simpler "contact me" / newsletter-style submission, e.g. the
// `formSource: 'lead'` variant of the hero CTA form.
model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String?
  sourcePath String? // which page/form this came from, e.g. '/aesthetics'
  status     String   @default("new") // new | contacted | converted | archived
  notes      String? // admin notes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int?
  createdAt DateTime @default(now())
}

model Treatment {
  id        String    @id @default(cuid())
  slug      String    @unique // matches current Treatment.slug in main.ts
  href      String    @unique // matches current Treatment.href (the route path)
  pillar    String
  audience  String?
  kind      String // 'variant' | 'hub' | 'modality'
  status    String    @default("published") // draft | published
  order     Int       @default(0)
  data      Json // everything else on the Treatment object (hero, symptoms, sections,
  // process, pricing, candidacy, faqs, closingCta, related, providers,
  // customsSection) as one JSON blob — the TS `Treatment` shape and every
  // existing component prop never has to change.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Press coverage shown on the public /in-the-news page — replaces the
// previously-hardcoded `expertsContent.press` list in src/content/pages/experts.ts.
model NewsItem {
  id           String   @id @default(cuid())
  title        String
  thumbnailUrl String
  newsLink     String
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, order])
}

// Generic — reused for EVERY page on the site, not just treatments: home, contact-us,
// our-experts, blog index, aesthetics, etc. One model, one admin screen, all SEO.
model PageSeo {
  id           String   @id @default(cuid())
  path         String   @unique // '/', '/contact-us', '/bioidentical-hormone-replacement-therapy/male'
  title        String?
  description  String?
  ogImageUrl   String?
  canonical    String?
  noindex      Boolean  @default(false)
  schemaJsonLd String? // optional raw JSON-LD override, admin-editable, validated as JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Admin-managed testimonials shown on the marketing site. Separate from the
// curated static `src/content/shared/testimonials.ts` list (sourced from
// Google reviews) — this table is the editable pool admins add to directly
// from the dashboard, with richer per-entry detail than the static shape.
model Testimonial {
  id        String    @id @default(cuid())
  name      String
  roleLabel String? // e.g. "Patient", "Verified Patient", a job title
  treatment String? // which treatment/service this testimonial references
  quote     String
  rating    Int       @default(5) // 1-5
  photoUrl  String?
  featured  Boolean   @default(false) // pinned to the top of the public list
  status    String    @default("published") // draft | published
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Singleton — one row, id fixed to "singleton". Logo, favicon, socials, tracking scripts.
model SiteSettings {
  id                    String   @id @default("singleton")
  siteName              String?
  tagline               String?
  logoUrl               String?
  logoDarkUrl           String?
  faviconUrl            String?
  phone                 String?
  email                 String?
  socialLinks           Json? // { facebook?, instagram?, youtube?, linkedin?, tiktok? }
  defaultSeoTitle       String?
  defaultSeoDescription String?
  defaultOgImageUrl     String?
  headerScripts         String? // raw HTML injected just before </head> — GTM, meta pixel, etc.
  footerScripts         String? // raw HTML injected just before </body>
  updatedAt             DateTime @updatedAt
}
